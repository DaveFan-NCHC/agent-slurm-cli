{
  "name": "@nchc/slurm-agent",
  "version": "0.10.1",
  "description": "A constrained Slurm lifecycle CLI over verified SSH",
  "type": "module",
  "bin": {
    "slurm-agent": "./dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "slurm-agent-policy.yaml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/make-executable.mjs",
    "build:pages": "node scripts/build-archify-pages.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ssh2": "^1.16.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.0",
    "@types/ssh2": "^1.15.5",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  },
  "license": "Apache-2.0"
}
